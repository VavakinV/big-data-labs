# Параметры графа
N <- 20
edges_matrix <- matrix(c(
1,3, 2,4, 3,4, 3,5, 4,6, 5,7, 6,7, 6,8, 7,9, 8,10
), ncol = 2, byrow = TRUE)
# Создаём граф с явным указанием количества вершин
g <- make_empty_graph(n = N, directed = FALSE) %>%
add_edges(as.vector(t(edges_matrix)))
# Устанавливаем имена вершин
V(g)$name <- as.character(1:N)
# Безопасная проверка двудольности с обработкой ошибок
is_bipartite <- tryCatch({
bm <- bipartite.mapping(g)
if(!bm$res) {
cat("Граф не является двудольным: NO\n")
FALSE
} else {
TRUE
}
}, error = function(e) {
cat("Граф не является двудольным: NO (ошибка в проверке)\n")
FALSE
})
# Если граф двудольный - обрабатываем и визуализируем
if(is_bipartite) {
bm <- bipartite.mapping(g)  # Повторно получаем разбиение
# Разбиваем вершины на две доли
part1 <- which(bm$type)
part2 <- which(!bm$type)
cat("Граф двудольный: YES\n")
cat("Доля 1:", sort(part1), "\n")
cat("Доля 2:", sort(part2), "\n")
# Визуализация графа
# 1. Устанавливаем цвета вершин по долям
V(g)$color <- ifelse(V(g) %in% part1, "lightblue", "salmon")
# 2. Создаём специальное расположение для двудольного графа
layout_matrix <- matrix(NA, nrow = N, ncol = 2)
layout_matrix[part1, 1] <- 0  # Первая доля слева
layout_matrix[part2, 1] <- 1  # Вторая доля справа
# Распределяем вершины равномерно по вертикали
layout_matrix[part1, 2] <- seq(1, 0, length.out = length(part1))
layout_matrix[part2, 2] <- seq(1, 0, length.out = length(part2))
}
plot(g)
# Параметры графа
