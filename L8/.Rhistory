plot(g, layout = coords)
}
N <- 20
edges_matrix <- matrix(c(1,3, 2,4, 3,5, 4,6, 5,7, 6,8, 7,9, 8,10), ncol = 2, byrow = TRUE)
g <- make_empty_graph(n = N, directed = FALSE)
g <- add_edges(g, as.vector(t(edges_matrix)))
V(g)$name <- as.character(1:N)
bm <- bipartite.mapping(g)
if (!bm$res) {
cat("Граф не является двудольным: NO\n")
} else {
# Разбиваем вершины на две доли
part1 <- V(g)$name[bm$type]
part2 <- V(g)$name[!bm$type]
cat("Граф двудольный: YES\n")
cat("Доля 1:", sort(as.integer(part1)), "\n")
cat("Доля 2:", sort(as.integer(part2)), "\n")
# Визуализация графа
# Устанавливаем цвета для вершин
V(g)$color <- ifelse(bm$type, "lightblue", "salmon")  # Доля 1 - голубой, доля 2 - розовый
V(g)$size <- 30
V(g)$label.color <- "black"
V(g)$frame.color <- NA
# Настраиваем расположение вершин (две колонки)
coords <- matrix(NA, nrow = length(V(g)), ncol = 2)
coords[bm$type, 1] <- 1   # Доля 1 - слева
coords[!bm$type, 1] <- 2  # Доля 2 - справа
coords[, 2] <- seq(1, 0, length.out = length(V(g)))  # Равномерно по вертикали
plot(g, layout = coords)
}
